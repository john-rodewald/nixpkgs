new file mode 100644
index 0000000000..027bb78dab
--- /dev/null
+++ b/scripts/lib/systemd.py
@@ -0,0 +1,36 @@
+import json
+import subprocess
+
+
+def list_systemd_processes(
+    filter_names: list[str] | None = None,
+    *,
+    only_running: bool | None = None,
+    systemctl_command: str = "systemctl",
+) -> list[str]:
+    sout = subprocess.check_output(
+        (
+            [
+                "systemctl",
+                "--output",
+                "json",
+                "--no-page",
+                "list-units",
+            ]
+            + (
+                ["--state", "active" if only_running else "inactive,failed"]
+                if only_running is not None
+                else []
+            )
+            + filter_names
+            if filter_names
+            else []
+        ),
+    )
+    units = json.loads(sout)
+    return [u["unit"] for u in units]
+
+
+def list_systemd_dependencies(unit: str, systemctl_command: str = "systemctl") -> list[str]:
+    sout = subprocess.check_output([systemctl_command, "--no-page", "list-dependencies", unit])
+    return [u.strip() for u in sout.split(b"\n") if u.startswith(b"  ")]
